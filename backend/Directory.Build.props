<Project>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'PrintAgent.Windows'">
    <BaseIntermediateOutputPath>$(TEMP)\UtcCoffeePrintAgent\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
    <MSBuildProjectExtensionsPath>$(TEMP)\UtcCoffeePrintAgent\$(MSBuildProjectName)\</MSBuildProjectExtensionsPath>
    <DefaultItemExcludes>$(DefaultItemExcludes);obj\**;bin\**</DefaultItemExcludes>
  </PropertyGroup>
</Project>
